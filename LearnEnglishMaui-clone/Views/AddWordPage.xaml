<!-- IngilizceProje/MAUIClient/Views/AddWordPage.xaml -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:IngilizceProjeMAUI.ViewModels"
             xmlns:converters="clr-namespace:IngilizceProjeMAUI.Converters"
             x:Class="IngilizceProjeMAUI.Views.AddWordPage"
             Title="{Binding IsEditMode, Converter={StaticResource BoolToValueConverter}, ConverterParameter='Kelimeyi Düzenle|Yeni Kelime Ekle'}"
             Background="{AppThemeBinding Light={StaticResource LightPageBg}, Dark={StaticResource DarkBgGradient}}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:BoolToValueConverter x:Key="BoolToValueConverter" />
            <Color x:Key="CardColor">#CC1E293B</Color>
            <Color x:Key="TextColor">#F8FAFC</Color>
            <Color x:Key="BorderColor">#312E81</Color>
        </ResourceDictionary>
    </ContentPage.Resources>

    <ScrollView Padding="20">
        <VerticalStackLayout Spacing="18" MaximumWidthRequest="500" HorizontalOptions="Fill">
            
            <!-- Error Label -->
            <Label Text="{Binding ErrorMessage}" TextColor="#EF4444" FontSize="13" FontAttributes="Bold"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource BoolToValueConverter}, ConverterParameter='True|False'}"/>

            <!-- English Word Entry with AI Auto-fill Button -->
            <VerticalStackLayout Spacing="6">
                <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                    <Label Grid.Column="0" Text="İngilizce Kelime *" TextColor="{AppThemeBinding Light={StaticResource LightText}, Dark={StaticResource TextColor}}" FontSize="13" FontAttributes="Bold" VerticalOptions="Center"/>
                    <HorizontalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                        <ActivityIndicator IsRunning="{Binding IsAiLoading}" IsVisible="{Binding IsAiLoading}" Color="#4F46E5" WidthRequest="18" HeightRequest="18"/>
                        <Button Text="✨ AI ile Doldur"
                                BackgroundColor="{AppThemeBinding Light=#EEF2FF, Dark=#312E81}"
                                TextColor="{AppThemeBinding Light=#4F46E5, Dark=#A5B4FC}"
                                BorderColor="{AppThemeBinding Light=#C7D2FE, Dark=#4F46E5}"
                                BorderWidth="1"
                                FontSize="11"
                                FontAttributes="Bold"
                                CornerRadius="6"
                                HeightRequest="30"
                                Padding="8,0"
                                Command="{Binding AutoFillWithAiCommand}"/>
                    </HorizontalStackLayout>
                </Grid>
                <Border Stroke="{AppThemeBinding Light=#CBD5E1, Dark=#334155}" StrokeShape="RoundRectangle 10" StrokeThickness="1" BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#1E293B}" HeightRequest="46">
                    <Entry Text="{Binding EnglishWord}" Placeholder="Örn: Algorithm" 
                           TextColor="{AppThemeBinding Light={StaticResource LightText}, Dark=White}" PlaceholderColor="{AppThemeBinding Light=#94A3B8, Dark=#64748B}" Margin="12,0" VerticalOptions="Center"/>
                </Border>
            </VerticalStackLayout>

            <!-- Turkish Meaning Entry -->
            <VerticalStackLayout Spacing="6">
                <Label Text="Türkçe Anlamı *" TextColor="{AppThemeBinding Light={StaticResource LightText}, Dark={StaticResource TextColor}}" FontSize="13" FontAttributes="Bold"/>
                <Border Stroke="{AppThemeBinding Light=#CBD5E1, Dark=#334155}" StrokeShape="RoundRectangle 10" StrokeThickness="1" BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#1E293B}" HeightRequest="46">
                    <Entry Text="{Binding TurkishMeaning}" Placeholder="Örn: Algoritma / Çözüm yolu" 
                           TextColor="{AppThemeBinding Light={StaticResource LightText}, Dark=White}" PlaceholderColor="{AppThemeBinding Light=#94A3B8, Dark=#64748B}" Margin="12,0" VerticalOptions="Center"/>
                </Border>
            </VerticalStackLayout>

            <!-- Word Type Picker -->
            <VerticalStackLayout Spacing="6">
                <Label Text="Kelime Türü" TextColor="{AppThemeBinding Light={StaticResource LightText}, Dark={StaticResource TextColor}}" FontSize="13" FontAttributes="Bold"/>
                <Border Stroke="{AppThemeBinding Light=#CBD5E1, Dark=#334155}" StrokeThickness="1" StrokeShape="RoundRectangle 10" BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#1E293B}">
                    <Picker ItemsSource="{Binding WordTypes}" SelectedItem="{Binding SelectedWordType}"
                            TextColor="{AppThemeBinding Light={StaticResource LightText}, Dark=White}" TitleColor="#94A3B8" HeightRequest="40"/>
                </Border>
            </VerticalStackLayout>

            <!-- Optional Context Sentence Entry (Where you learned/encountered the word) -->
            <VerticalStackLayout Spacing="6">
                <HorizontalStackLayout Spacing="6">
                    <Label Text="Öğrendiğin Yer / Cümle" TextColor="{AppThemeBinding Light={StaticResource LightText}, Dark={StaticResource TextColor}}" FontSize="13" FontAttributes="Bold"/>
                    <Label Text="(İsteğe Bağlı)" TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" FontSize="12" VerticalOptions="Center"/>
                </HorizontalStackLayout>
                <Border Stroke="{AppThemeBinding Light=#CBD5E1, Dark=#334155}" StrokeShape="RoundRectangle 10" StrokeThickness="1" BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#1E293B}" HeightRequest="82" Padding="8">
                    <Editor Text="{Binding ExampleSentence}" Placeholder="Kelimeyi okuduğunuz veya karşılaştığınız yerdeki cümle (zorunlu değildir)..." 
                            TextColor="{AppThemeBinding Light={StaticResource LightText}, Dark=White}" PlaceholderColor="{AppThemeBinding Light=#94A3B8, Dark=#64748B}" BackgroundColor="Transparent"/>
                </Border>
            </VerticalStackLayout>

            <!-- EDIT MODE ONLY FIELDS -->
            <VerticalStackLayout Spacing="16" IsVisible="{Binding IsEditMode}">
                <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#E2E8F0, Dark=#334155}"/>

                <!-- Learning Status Picker -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="Öğrenme Durumu" TextColor="{AppThemeBinding Light={StaticResource LightText}, Dark={StaticResource TextColor}}" FontSize="13" FontAttributes="Bold"/>
                    <Border Stroke="{AppThemeBinding Light=#CBD5E1, Dark=#334155}" StrokeThickness="1" StrokeShape="RoundRectangle 10" BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#1E293B}">
                        <Picker ItemsSource="{Binding LearningStatuses}" SelectedItem="{Binding LearningStatus}"
                                TextColor="{AppThemeBinding Light={StaticResource LightText}, Dark=White}" TitleColor="#94A3B8" HeightRequest="40"/>
                    </Border>
                </VerticalStackLayout>

                <!-- Is Favorite Switch -->
                <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center" HeightRequest="40">
                    <Label Grid.Column="0" Text="Favorilere Ekle" TextColor="{AppThemeBinding Light={StaticResource LightText}, Dark={StaticResource TextColor}}" FontSize="13" FontAttributes="Bold" VerticalOptions="Center"/>
                    <Switch Grid.Column="1" IsToggled="{Binding IsFavorite}" ThumbColor="#6366F1" OnColor="{AppThemeBinding Light=#EEF2FF, Dark=#312E81}" VerticalOptions="Center"/>
                </Grid>
            </VerticalStackLayout>

            <!-- Action Buttons -->
            <Grid ColumnDefinitions="*, *" ColumnSpacing="12" Margin="0,10,0,0">
                <Button Grid.Column="0" Text="İptal ❌" Command="{Binding CancelCommand}"
                        Background="{StaticResource DangerGradient}" TextColor="White" FontAttributes="Bold" HeightRequest="46" CornerRadius="10"/>
                <Button Grid.Column="1" Text="Kaydet 💾" Command="{Binding SaveCommand}"
                        Background="{StaticResource PrimaryGradient}" TextColor="White" FontAttributes="Bold" HeightRequest="46" CornerRadius="10"/>
            </Grid>

            <ActivityIndicator IsRunning="{Binding IsBusy}" Color="#6366F1" HorizontalOptions="Center" HeightRequest="30"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
