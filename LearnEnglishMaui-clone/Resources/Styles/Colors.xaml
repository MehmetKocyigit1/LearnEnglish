<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- ========================================================================= -->
    <!-- MODERN EDTECH COLOR SYSTEM & DESIGN TOKENS (Duolingo & Quizlet Inspired)  -->
    <!-- ========================================================================= -->

    <!-- Primary Brand: Electric Indigo (Mental Energy, Focus, Intelligence) -->
    <Color x:Key="Primary">#4F46E5</Color>
    <Color x:Key="PrimaryLight">#EEF2FF</Color>
    <Color x:Key="PrimaryDark">#3730A3</Color>
    <Color x:Key="PrimaryDarkText">#FFFFFF</Color>

    <!-- Secondary: Vibrant Electric Violet & Rose (Playful Motivation) -->
    <Color x:Key="Secondary">#8B5CF6</Color>
    <Color x:Key="SecondaryDarkText">#C4B5FD</Color>
    <Color x:Key="Tertiary">#F59E0B</Color>

    <!-- Gamification & Status Accents -->
    <Color x:Key="Success">#10B981</Color>
    <Color x:Key="SuccessLight">#ECFDF5</Color>
    <Color x:Key="Warning">#F59E0B</Color>
    <Color x:Key="WarningLight">#FFFBEB</Color>
    <Color x:Key="Danger">#EF4444</Color>
    <Color x:Key="DangerLight">#FEF2F2</Color>
    <Color x:Key="Info">#3B82F6</Color>
    <Color x:Key="InfoLight">#EFF6FF</Color>

    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="Black">#0B0F19</Color>
    <Color x:Key="Magenta">#4F46E5</Color>
    <Color x:Key="MidnightBlue">#0F172A</Color>
    <Color x:Key="OffBlack">#0B0F19</Color>

    <!-- Modern Slate Scale -->
    <Color x:Key="Gray100">#F1F5F9</Color>
    <Color x:Key="Gray200">#E2E8F0</Color>
    <Color x:Key="Gray300">#CBD5E1</Color>
    <Color x:Key="Gray400">#94A3B8</Color>
    <Color x:Key="Gray500">#64748B</Color>
    <Color x:Key="Gray600">#475569</Color>
    <Color x:Key="Gray900">#0F172A</Color>
    <Color x:Key="Gray950">#020617</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource Success}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource Danger}"/>

    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>

    <!-- Modern Gradients (High Visual Engagement) -->
    <!-- Deep Cosmic Luxury Slate (Dark Mode) -->
    <LinearGradientBrush x:Key="DarkBgGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#080C14" Offset="0.0" />
        <GradientStop Color="#0F172A" Offset="0.45" />
        <GradientStop Color="#1A1838" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Soft Clean Slate (Light Mode) -->
    <LinearGradientBrush x:Key="LightBgGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FAF5FF" Offset="0.0" />
        <GradientStop Color="#F8FAFC" Offset="0.4" />
        <GradientStop Color="#EEF2FF" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Electric Indigo to Royal Violet (Hero / CTA Gradient) -->
    <LinearGradientBrush x:Key="PrimaryGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#4F46E5" Offset="0.0" />
        <GradientStop Color="#7C3AED" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Emerald Glow (Achievement / Victory Gradient) -->
    <LinearGradientBrush x:Key="SuccessGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#10B981" Offset="0.0" />
        <GradientStop Color="#059669" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Warm Amber to Sunburst Orange (Streak / XP / Fire) -->
    <LinearGradientBrush x:Key="StreakGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#F59E0B" Offset="0.0" />
        <GradientStop Color="#EA580C" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Cyber AI Violet to Fuchsia (AI Başöğretmen) -->
    <LinearGradientBrush x:Key="AiGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#8B5CF6" Offset="0.0" />
        <GradientStop Color="#EC4899" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Coral Red (Gentle Warning Gradient) -->
    <LinearGradientBrush x:Key="DangerGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#F43F5E" Offset="0.0" />
        <GradientStop Color="#E11D48" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Azure Blue (Information / Practice Gradient) -->
    <LinearGradientBrush x:Key="BlueGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#3B82F6" Offset="0.0" />
        <GradientStop Color="#1D4ED8" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Glassmorphism Styles (Dark Theme Elevated Cards) -->
    <Color x:Key="GlassBorderColor">#2E384D</Color>
    <SolidColorBrush x:Key="GlassBorderBrush" Color="{StaticResource GlassBorderColor}"/>
    <Color x:Key="GlassBgColor">#E61E293B</Color>
    <SolidColorBrush x:Key="GlassBgBrush" Color="{StaticResource GlassBgColor}"/>

    <!-- Word Card Gradient -->
    <LinearGradientBrush x:Key="WordCardGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#1E1B4B" Offset="0.0" />
        <GradientStop Color="#0F172A" Offset="1.0" />
    </LinearGradientBrush>

    <!-- High-Contrast Light Theme UI Colors -->
    <Color x:Key="LightPageBg">#F8FAFC</Color>
    <Color x:Key="LightCardBg">#FFFFFF</Color>
    <Color x:Key="LightInputBg">#F1F5F9</Color>
    <Color x:Key="LightBorder">#CBD5E1</Color>
    <Color x:Key="LightText">#0F172A</Color>
    <Color x:Key="LightTextSecondary">#475569</Color>

    <LinearGradientBrush x:Key="LightCardGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFFFFF" Offset="0.0" />
        <GradientStop Color="#F8FAFC" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Professional Accent Colors -->
    <Color x:Key="LavenderAccent">#C7D2FE</Color>
    <SolidColorBrush x:Key="LavenderAccentBrush" Color="{StaticResource LavenderAccent}"/>
</ResourceDictionary>